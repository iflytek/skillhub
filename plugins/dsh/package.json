{
  "name": "@astron-team/skillhub-dsh",
  "version": "0.5.0",
  "private": false,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "probe:registry": "bun run scripts/probe-registry.ts",
    "check": "bun run build && bun run typecheck && bun run lint && bun test",
    "lint": "node ../../cli/node_modules/eslint/bin/eslint.js --resolve-plugins-relative-to ../../cli src scripts test --ext .ts,.tsx,.mjs"
  },
  "exports": {
    "./types": {
      "types": "./lib/types/host/types.d.ts"
    },
    ".": {
      "types": "./lib/types/host/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/local-core.js",
    "lib/client.js",
    "lib/types",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "external": [
        "react",
        "react/jsx-runtime",
        "react-dom"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4 || 4.0.5",
    "@deepseek-ai/dsh-fs": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-session-query": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-user-questions": "0.2.0-rc.2 || 0.2.1-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4",
    "@radix-ui/react-avatar": "1.3.1",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-tabs": "1.2.1",
    "@tanstack/react-query": "5.90.21",
    "class-variance-authority": "0.7.1",
    "react-markdown": "10.1.0",
    "rehype-sanitize": "6.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.1-rc.2",
    "@deepseek-ai/dsh-app-boot": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-tool": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-generator": "0.2.0-rc.2",
    "@types/bun": "1.3.13",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.1",
    "playwright": "1.58.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "6.0.3",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/cordis-plugin-include": "1.0.10",
    "@deepseek-ai/cordis-plugin-timer": "1.1.7",
    "@deepseek-ai/dsh-user-questions": "0.2.1-rc.2",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-query": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2"
  },
  "engines": {
    "node": ">=24.2.0 <25"
  },
  "description": "Native SkillHub browsing and local skill management for DeepSeek Harness",
  "repository": {
    "type": "git",
    "url": "https://github.com/iflytek/skillhub.git",
    "directory": "plugins/dsh"
  },
  "homepage": "https://github.com/iflytek/skillhub/tree/main/plugins/dsh#readme",
  "bugs": {
    "url": "https://github.com/iflytek/skillhub/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/cordis-plugin-include": "1.0.10",
    "@deepseek-ai/cordis-plugin-timer": "1.1.7"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-user-questions": {
      "optional": true
    }
  }
}
