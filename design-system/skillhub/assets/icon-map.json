{
  "schemaVersion": 1,
  "library": "lucide-react",
  "versionRange": "^0.344.0",
  "strokeWidth": {
    "note": "24 viewBox 下的无单位用户单位；= 目标视觉线宽 × 24 / 渲染尺寸 / 0.955（墨迹归一化缩放），完整规则见 specs/icons.md",
    "12": 3.14,
    "14": 2.72,
    "16": 2.36,
    "18": 2.44,
    "20": 2.2,
    "24": 2.09
  },
  "sizes": {
    "16": "标准三档（小）：默认行内图标、按钮图标、输入框前后缀；视觉线宽 1.5px",
    "20": "标准三档（中）：区块标题、卡片标题、工具条主操作、图标按钮；视觉线宽 1.75px",
    "24": "标准三档（大）：空态、引导块、少量强调；视觉线宽 2px",
    "12": "例外档：徽标内提示、表格内状态；不用于按钮",
    "14": "例外档：紧凑工具栏、分页、下拉项",
    "18": "例外档：Tab、筛选栏、二级导航、代码块操作条"
  },
